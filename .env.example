# Database
POSTGRES_DB=phone_gateway_db
POSTGRES_USER=phone_user
POSTGRES_PASSWORD=phone_pass

GEMINI_API_KEY=
GEMINI_API_KEY_FREE=
GEMINI_API_KEY_FREE_2=
GEMINI_API_KEY_FREE_3=

# JWT shared between logic_service and phone_gateway
JWT_SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PBKDF2_ITERATIONS=600000

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin


# Admin Seeding
DEFAULT_ADMIN_NAME="System Admin"
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@gmail.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Hugging Face
HF_TOKEN=

# Admin dashboard
ADMIN_DASHBOARD_ORIGIN=http://localhost:3000
EXTRA_CORS_ORIGINS=http://localhost:3001


TTS_PROVIDER=gtts
TTS_ENABLE_GTTS=1
TTS_SAMPLE_RATE=16000

SILENCE_REPROMPT_SEC=15
MAX_SILENCE_REPROMPTS=2
MAX_ASR_REPROMPTS=3
NOISE_TOGGLE_WINDOW_SEC=6
NOISE_TOGGLE_MAX_EVENTS=8
MAX_NOISE_REPROMPTS=2

RAG_ESCALATE_OUT_OF_DOMAIN=1
RAG_OUT_OF_DOMAIN_NLU_CONFIDENCE=0.35
RAG_COMPLEX_ESCALATION_CONFIDENCE=0.45


ASR_CONFIRMATION_MIN_WORDS=3
ASR_CONFIRMATION_UNUSUAL_RATIO=0.55
ASR_CONFIRMATION_MIN_UNUSUAL_WORDS=2
ASR_CONFIRMATION_MIN_CONFIDENCE=0.68

# Short prompts are synthesized in one chunk to avoid gaps between sentences.
VAD_TTS_SINGLE_CHUNK_MAX_CHARS=180

# Long RAG/expert answers are split into smaller TTS requests for clearer speech.
VAD_TTS_CHUNK_MAX_CHARS=140
SIP_TTS_CHUNK_MAX_CHARS=140

TTS_SAMPLE_RATE=16000
TTS_ATEMPO=1.5
TTS_VOLUME=1.5
SIP_AUDIOSOCKET_SAMPLE_RATE=16000
SIP_ALERT_AUDIOSOCKET_SAMPLE_RATE=16000
SIP_CHECK_ENDPOINT_CONTACTS=1

# ── SIP alert call notifications ──────────────────────────────────────────────
ALERT_CALL_MAX_RECIPIENTS=50
EXPERT_RESPONSE_CALL_ENABLED=1
EXPERT_RESPONSE_CALLBACK_WAIT_SECONDS=300
EXPERT_RESPONSE_CALLBACK_POLL_SECONDS=5
ASTERISK_AMI_USERNAME=farmer_admin
ASTERISK_AMI_PASSWORD=farmer_admin_dev
SIP_ALERT_DEFAULT_ENDPOINT=farmeruhamayohannes

# ── Voice playback ────────────────────────────────────────────────────────────
# VAD thresholds for SIP/8 kHz audio. Higher thresholds reduce noise triggers;
# the shorter start window still allows words like "selam", "እሺ", and "አዎ".
VAD_THRESHOLD=0.62
VAD_ENERGY_THRESHOLD=0.018
VAD_ENERGY_MIN_SPEECH_PROB=0.20
VAD_MIN_SPEECH_MS=160
VAD_END_SILENCE_MS=900
