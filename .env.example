HF_TOKEN=your_huggingface_token_here

# ── LLM: one key per teammate (comma-separated, no spaces required) ───────────
# Groq is tried first when RAG_LLM_BACKEND=groq (default if keys exist).
GROQ_API_KEYS=gsk_person1,gsk_person2,gsk_person3,gsk_person4,gsk_person5
GEMINI_API_KEYS=AIza_person1,AIza_person2,AIza_person3,AIza_person4,AIza_person5

# Legacy single-key names still work:
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza_...
# ASR can use a separate free Gemini pool for post-ASR typo fixes:
# FREE_GEMINI_API_KEYS=AIza_free1,AIza_free2
# Set to 1 only if ASR may fall back to shared/paid GEMINI_API_KEY(S).
ASR_USE_SHARED_GEMINI_KEYS=0

RAG_LLM_BACKEND=groq
GROQ_GEMINI_FALLBACK=1
# Seconds to pause a key after HTTP 429/503 before reusing it (default 90)
RAG_API_KEY_COOLDOWN_SEC=90

# ── ASR typo fix (Gemini after local Whisper) ─────────────────────────────────
ASR_ENGINE=whisper_local
ASR_MODEL_PATH=./models/asr/whisper-small-amharic-bdu-8khz-aug-ct2-fp16

ASR_HOSTED_LLM_FIX=auto
# gemini | gemini_then_groq | groq_then_gemini | groq
# gemini means Gemini fixes the local ASR transcript and local ASR output is fallback.
ASR_LLM_FIX_BACKEND=gemini
# Keep one Gemini API call per transcript; failed keys cool down and the next
# transcript rotates to another key.
ASR_LLM_FIX_MAX_KEYS_PER_REQUEST=1
ASR_USE_OLLAMA=false


